generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  balance       Float     @default(0)      // Saldo em R$
  role          String    @default("USER") // USER ou ADMIN
  active        Boolean   @default(true)   // Para banir ou desativar
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Controle de segurança do painel admin
  adminAttempts     Int       @default(0)
  adminLockoutUntil DateTime?
  lastActiveAt      DateTime?
  whatsapp          String?
  hasSeenPromoPopup Boolean   @default(true)
  hasAcceptedTerms  Boolean   @default(false)
  trafficSource     String?   @default("orgânico")
  
  // Sistema de Indicações (Auto-relacionamento)
  referralCode      String?   @unique // Código de indicação deste usuário (ex: "2YGUTMND")
  referredById      String?           // ID de quem indicou este usuário
  referrer          User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals         User[]    @relation("UserReferrals")

  transactions         Transaction[]
  searches             SearchHistory[]
  referralTransactions ReferralTransaction[]
}

model ReferralTransaction {
  id          String   @id @default(uuid())
  userId      String   // Usuário que recebeu a comissão (o afiliado)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromUserId  String   // Usuário indicado que gerou a comissão (quem recarregou)
  amount      Float    // Valor em R$ da comissão
  createdAt   DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float    // Valor em R$ movimentado (positivo para recarga, negativo para gasto)
  type        String   // "DEPOSIT", "USAGE", "REFUND", "ADJUSTMENT"
  description String?
  status      String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  externalId  String?  @unique // ID na PushinPay ou gateway externo
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchHistory {
  id          String   @id @default(uuid())
  userId      String
  query       String   // e.g., CPF, CNPJ, Plate
  target      String   // Type of search: "cpf-basico-pessoa-fisica"
  cost        Float    // Custo da consulta em R$
  status      String   // "SUCCESS", "FAILED"
  result      Json?    // Stored result or partial data
  modules     String?  // IDs dos módulos selecionados (JSON ou lista separada por vírgula)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id                    String   @id @default("default")
  siteTitle             String   @default("Detetive Buscas")
  siteDescription       String   @default("Investigação de dados profissional. Consulte CPF, CNPJ, Veículos e muito mais.")
  siteKeywords          String   @default("consultas, cpf, cnpj, veículos, investigação")
  faviconUrl            String?
  logoUrl               String?
  companyName           String?  @default("NOME DA EMPRESA LTDA")
  companyCnpj           String?  @default("00.000.000/0001-00")
  companyAddress        String?  @default("Endereço Completo, Cidade - UF")
  companyEmail          String?  @default("contato@seusite.com")
  supportWhatsapp       String?  @default("5511999999999")
  pushinpayToken        String?
  pushinpayWebhookToken String?
  pixFee                Float?   @default(0.95)
  
  // Chaves de APIs Externas configuráveis
  brevoApiKey           String?
  directDataToken       String?
  directDataBaseUrl     String?
  directDataV3Url       String?
  apiConsultaToken      String?
  apiConsultaUrl        String?
  
  updatedAt             DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // "INFO", "WARNING", "ERROR"
  message   String
  context   Json?    // Detalhes extras, ex: { userId, endpoint, error }
  createdAt DateTime @default(now())
}

model ModulePricing {
  id          String   @id // e.g., "dados_basicos"
  name        String       // e.g., "Dados básicos"
  category    String       // e.g., "Dados pessoais"
  price       Float        // e.g., 0.25 (em R$)
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model AdminPushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?  // Opcional, para atrelar a um admin específico se tivermos login
  createdAt DateTime @default(now())
}

model Page {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  metaDescription String?
  h1              String?
  excerpt         String?   @db.Text
  content         String    @db.Text
  image           String?
  imageAlt        String?
  canonical       String?
  robotsIndex     Boolean   @default(true)
  showInMenu      Boolean   @default(false)
  showInFooter    Boolean   @default(false)
  jsonLd          String?   @db.Text
  openGraph       String?   @db.Text
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
}

model Article {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  metaDescription String?
  h1              String?
  excerpt         String?   @db.Text
  content         String    @db.Text
  image           String?
  imageAlt        String?
  canonical       String?
  robotsIndex     Boolean   @default(true)
  jsonLd          String?   @db.Text
  openGraph       String?   @db.Text
  published       Boolean   @default(false)
  publishedAt     DateTime?
  author          String    @default("Redação")
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Redirect {
  id        String   @id @default(uuid())
  oldSlug   String   @unique
  newSlug   String
  type      String   @default("PAGE") // PAGE ou ARTICLE
  createdAt DateTime @default(now())
}

model BlockedData {
  id        String   @id @default(uuid())
  type      String   // "CPF", "TELEFONE", "CNPJ", "PLACA"
  value     String   @unique // Valor higienizado/sem pontuação
  reason    String?
  createdAt DateTime @default(now())
}

